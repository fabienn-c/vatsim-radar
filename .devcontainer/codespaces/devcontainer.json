{
  "name": "vatsim-radar (Codespaces test - temporary)",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "VATSIM Radar" }
  },
  "postCreateCommand": "cp -n .env.example .env"
}
